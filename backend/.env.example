# Copy this to .env and update values

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/basketball_app

# JWT Authentication
SECRET_KEY=replace-this-with-a-random-64-character-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Debug mode (set to False in production)
DEBUG=True

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=basketball-app-videos
