# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Database (Railway provides this automatically — change postgresql:// to postgresql+asyncpg://)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# JWT Authentication — use a random 64-char hex string in production
SECRET_KEY=CHANGE_ME_use_python_secrets.token_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Debug mode (must be False in production)
DEBUG=False

# Cloudflare R2 Video Storage
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=basketball-app-videos
