{
  "expo": {
    "name": "Summit Hoops",
    "slug": "summit-hoops",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1A2E"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.summithoops.app",
      "buildNumber": "1",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": []
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A1A2E"
      },
      "package": "com.summithoops.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "privacyPolicyUrl": "https://woody-14.github.io/basketball_app/website/privacy-policy.html",
      "supportEmail": "summit.athletic.training@gmail.com",
      "eas": {
        "projectId": "ef0b607b-18ab-4116-8bd5-68bb34c7ff0c"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Summit Hoops to use your camera to record form check videos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Summit Hoops to access your photos to upload form check videos."
        }
      ],
      "expo-font",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FF5C16",
          "sounds": []
        }
      ]
    ]
  }
}
